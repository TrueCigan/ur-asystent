# Local and CI eval defaults for the current Python/FastAPI app.
# Not a Render production template. Do not copy LLM_PROVIDER=fake onto the live service.
# Secrets stay empty. Never commit a filled copy.
# A real provider with a key is not replaced by the fake adapter.
# EVAL_REAL=0 keeps the eval/embedding adapters off the network.
# SCENARIO_SOCIAL=0 matches the code default (unset is also off). The live
# service reported the flag on 2026-11-09; that is not copied here.

LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Temperature is omitted when the model name starts with claude-haiku-5.
# LLM_SEND_TEMPERATURE=0 forces the field off. LLM_SEND_TEMPERATURE=1 forces it on.
# Model-path defaults (override the prompt manifest): answer timeout 12s,
# max output tokens 1200, 3 context chunks, 400 chars each, 4 fact cards, 240 chars each.
# The circuit breaker stays 5 provider errors in 30s, then a 60s pause.
# ANSWER_TIMEOUT_S=12
# ANSWER_MAX_TOKENS=1200
# ANSWER_BUDGET_S=15
# ANSWER_CONTEXT_CHUNKS=3
# ANSWER_CHUNK_CHARS=400
# ANSWER_FACT_CARDS=4
# ANSWER_CARD_CHARS=240

GEMINI_API_KEY=

EMBEDDINGS_PROVIDER=disabled
EMBED_PROVIDER=disabled
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=

EVAL_REAL=0
# In-process retention only: technical rows 30 days, samples 7, summaries 90.
# This is not a GDPR compliance claim. The rows vanish when the process stops.
UNIVERSITY_TIMEZONE=Europe/Warsaw
SCENARIO_SOCIAL=0
FACTS_INJECT_UNVERIFIED=0
EXTRACTOR_LLM=0
SIM_LLM=

SESSION_SECRET=

# Optional HMAC secret for the rate limiter. Empty falls back to SESSION_SECRET,
# then to a process-local secret. The raw network id is not stored.
# RATE_LIMIT_SECRET=

# Admin passwords stay empty here. Unset means /admin/ai stays closed.
# Do not put these values in the page or in a browser bundle.
# ADMIN_VIEWER_PASSWORD=
# ADMIN_EDITOR_PASSWORD=
# ADMIN_ADMIN_PASSWORD=
# ADMIN_TOKEN_SECRET=

# Optional daily generation cap in USD. Empty means no cap is configured.
# DAILY_GENERATION_BUDGET_USD=

# Optional USD per 1M tokens. Empty means the price is unknown, not zero.
# These examples are not a live provider bill.
# PRICE_INPUT_PER_1M=
# PRICE_OUTPUT_PER_1M=
# PRICE_CACHED_INPUT_PER_1M=
# PRICE_EMBEDDING_PER_1M=

# Test knob for the fake LLM only: ok, timeout, quota (or 429), unavailable,
# invalid_json, forbidden_citation. Ignored when LLM_PROVIDER is a real provider.
FAKE_LLM_MODE=ok

PORT=10000
